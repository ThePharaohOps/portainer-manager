HOST_IP=
ADMIN_PASSWORD=change-me
SESSION_SECRET=
PORT=3000

# ── OIDC (SSO) — optionnel, laisser vide pour désactiver ─────────────────────
# OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/auth/oidc/callback
# OIDC_SCOPE=openid profile email
# OIDC_DISPLAY_NAME=SSO
# OIDC_ALLOW_INSECURE=false
# OIDC_ROLE_CLAIM=groups
# OIDC_ADMIN_GROUP=

# ── Prometheus (/metrics) — optionnel, sans jeton l'accès requiert une session ─
# METRICS_TOKEN=

# ── Sécurité de la connexion ─────────────────────────────────────────────────
# Derrière un reverse proxy : 1 (un proxy) pour que la limite de tentatives voie la vraie IP du client
# TRUST_PROXY=1
# Échecs de mot de passe tolérés par IP avant blocage de 15 min (défaut : 10)
# LOGIN_MAX_ATTEMPTS=10
